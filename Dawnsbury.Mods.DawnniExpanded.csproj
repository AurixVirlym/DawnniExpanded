        <TargetFramework>net9.0-windows</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>
  <PropertyGroup>
    <WarningsAsErrors>4014</WarningsAsErrors>
    <HideWarningsAndErrors>1998</HideWarningsAndErrors>
